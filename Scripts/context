#!/bin/bash
# Cheap repository snapshot. Read-only.
set -uo pipefail
cd "$(dirname "$0")/.."

echo "REPO      finance-app — native local-first iOS personal finance app"
echo "BRANCH    $(git branch --show-current)"
echo "HEAD      $(git log -1 --format='%h %s')"

DIRTY=$(git status --porcelain | wc -l | tr -d ' ')
if [ "$DIRTY" = "0" ]; then
    echo "TREE      clean"
else
    echo "TREE      $DIRTY changed path(s):"
    git status --short | head -20 | sed 's/^/          /'
    [ "$DIRTY" -gt 20 ] && echo "          … $((DIRTY - 20)) more"
fi

WT=$(git worktree list | wc -l | tr -d ' ')
[ "$WT" -gt 1 ] && { echo "WORKTREES"; git worktree list | sed 's/^/          /'; }

XC=$(xcodebuild -version 2>/dev/null | head -1)
[ -z "$XC" ] && [ -d /Applications/Xcode.app ] && XC="$(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -version 2>/dev/null | head -1) (via DEVELOPER_DIR; xcode-select points at $(xcode-select -p))"
echo "TOOLS     ${XC:-xcodebuild NOT AVAILABLE}"
echo "          swift $(swift --version 2>&1 | grep -oE 'Apple Swift version [0-9.]+' | awk '{print $4}')"
echo "DEST      ${FINANCE_APP_DESTINATION:-platform=iOS Simulator,name=iPhone 17}  (override: FINANCE_APP_DESTINATION)"
echo
echo "VALIDATE  Scripts/test-core       swift test in Packages/FinanceCore"
echo "          Scripts/test-app        xcodebuild test, app + integration"
echo "          Scripts/build-debug     Debug build only"
echo "          Scripts/release-gate    Release build + fixture-absence proof"
echo "          Scripts/check           core tests + Debug build (quick gate)"
echo
echo "DOCS      README.md for the product, docs/architecture.md for the boundary."
